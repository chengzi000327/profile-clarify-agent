NODE_ENV=development
PORT=4100
# Leave unset to use the in-memory demo store. Uncomment for PostgreSQL.
# DATABASE_URL=postgres://role_agent:role_agent@localhost:5432/role_agent
SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:5173

# mock = deterministic CI/test adapter; sidecar = real DeepSeek Harness bridge.
HARNESS_MODE=sidecar
HARNESS_BASE_URL=http://localhost:4110
HARNESS_SIDECAR_TOKEN=replace-with-a-random-sidecar-token
SIDECAR_PORT=4110
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

AGENT_CONCURRENCY=4
TOOL_TIMEOUT_MS=5000
ROLE_AGENT_TOOL_TOKEN=replace-with-a-random-internal-tool-token

# Feishu bot (optional). Configure an unencrypted webhook event subscription for MVP.
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_WORKSPACE_ID=your-company-workspace
# Map Feishu open_id to an existing Web account when both channels should share identity.
# Example: {"ou_xxx":{"account_id":"zhangsan","display_name":"张三","role":"MANAGER"}}
FEISHU_USER_MAPPINGS_JSON={}
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
